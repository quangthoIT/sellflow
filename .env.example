# App Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Administrator Account
ADMIN_EMAIL="admin@sellflow.vn"
ADMIN_PASSWORD="your_secure_admin_password"
NEXT_PUBLIC_ADMIN_EMAIL="admin@sellflow.vn"
NEXT_PUBLIC_ADMIN_PASSWORD="your_secure_admin_password"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellflow_db?schema=public"

# Redis Cache & Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET="sellflow_super_secret_jwt_key_2026"

# Storage Settings
STORAGE_PATH="./storage"

# Email / SMTP Configuration (Gmail App Password hoặc SMTP Host tùy chỉnh)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="SellFlow Support"
