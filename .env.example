# ==========================================
# SELLFLOW - ENVIRONMENT CONFIGURATION
# ==========================================

# App & Ports
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellflow_db?schema=public"

# JWT Secret Key
JWT_SECRET="sellflow_super_secret_jwt_key_2026"

# SMTP Email Configuration (Optional - Có thể cấu hình trực tiếp trên giao diện)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="SellFlow Support"
