# App Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellflow_db?schema=public"

# Redis Cache & Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET="sellflow_super_secret_jwt_key_2026"

# Storage Settings
STORAGE_PATH="./storage"

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@sellflow.com"
SMTP_PASS="your_password_here"
SMTP_FROM="SellFlow <noreply@sellflow.com>"
